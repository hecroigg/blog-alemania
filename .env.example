NEXT_PUBLIC_GA_ID=

# Optional advertising. Ad slots stay disabled when empty.
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_ADSENSE_SLOT_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_BODY=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
